+def _tran_testbench(end_time: str = "50m") -> TestBench:
+    return TestBench(
+        name="tran_completion_tb",
+        category="tran",
+        circuit_name="demo",
+        analyses=[
+            AnalysisConfig(
+                type=AnalysisType.TRANSIENT,
+                parameters={"step_time": "10u", "end_time": end_time, "start_time": 0},
+            )
+        ],
+        measurements=[Measurement(name="output_swing_v", expression="max(vout)-min(vout)", unit="V")],
+    )
+
+
+def test_transient_completion_rejects_partial_waveform():
+    simulator = PySpiceSimulator(allow_mock=True)
+    status = simulator._transient_completion_status(
+        {"transient": {"time": [0.0, 50e-6, 99.7289e-6], "vout": [2.5, 2.2, 1.95]}},
+        _tran_testbench("50m"),
+    )
+
+    assert status["requested"] is True
+    assert status["complete"] is False
+    assert status["expected_stop_s"] == 0.05
+    assert status["observed_stop_s"] == 99.7289e-6
+    assert status["completion_ratio"] < 0.01
+
+
+def test_transient_completion_accepts_requested_horizon():
+    simulator = PySpiceSimulator(allow_mock=True)
+    status = simulator._transient_completion_status(
+        {"transient": {"time": [0.0, 0.025, 0.05], "vout": [0.0, 1.0, 0.0]}},
+        _tran_testbench("50m"),
+    )
+
+    assert status["complete"] is True
+    assert status["completion_ratio"] == 1.0
+
+
+def test_ngspice_abort_text_is_classified_as_transient_incomplete():
+    simulator = PySpiceSimulator(allow_mock=True)
+    result = {
+        "success": False,
+        "errors": [
+            'doAnalyses: TRAN: Timestep too small; time = 9.97289e-05, timestep = 1.25e-17',
+            'run simulation(s) aborted',
+        ],
+    }
+
+    assert simulator._execution_status_from_result(result) == "ERROR"
+    assert simulator._error_type_from_result(result) == "transient_incomplete"
