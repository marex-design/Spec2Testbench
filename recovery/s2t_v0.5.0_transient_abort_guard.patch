+    def _transient_completion_status(self, results: Dict[str, Any], testbench: TestBench) -> Dict[str, Any]:
+        """Check that a transient analysis reached its requested stop time.
+
+        ngspice may leave a partial WRDATA file after a convergence abort and
+        may even exit with return code 0.  Partial waveform evidence is useful
+        for diagnostics but must never be promoted to a scientifically valid
+        SUCCESS.
+        """
+        transient_analysis = next(
+            (analysis for analysis in testbench.analyses if analysis.type == AnalysisType.TRANSIENT),
+            None,
+        )
+        if transient_analysis is None:
+            return {"requested": False, "complete": True}
+
+        expected_stop = self._parse_spice_numeric(transient_analysis.parameters.get("end_time"))
+        if expected_stop is None or expected_stop <= 0:
+            return {"requested": True, "complete": None, "expected_stop_s": expected_stop}
+
+        transient = results.get("transient") or results.get("tran") or {}
+        try:
+            time_values = np.asarray(transient.get("time", []), dtype=float)
+        except (TypeError, ValueError):
+            time_values = np.asarray([], dtype=float)
+        finite = time_values[np.isfinite(time_values)] if time_values.size else time_values
+        if finite.size == 0:
+            return {
+                "requested": True,
+                "complete": False,
+                "expected_stop_s": float(expected_stop),
+                "observed_stop_s": None,
+                "completion_ratio": 0.0,
+            }
+
+        observed_stop = float(np.max(finite))
+        completion_ratio = observed_stop / float(expected_stop)
+        return {
+            "requested": True,
+            "complete": bool(observed_stop >= 0.99 * float(expected_stop)),
+            "expected_stop_s": float(expected_stop),
+            "observed_stop_s": observed_stop,
+            "completion_ratio": float(completion_ratio),
+        }
     
