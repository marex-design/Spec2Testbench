diff --git a/tests/test_llm_planning_components.py b/tests/test_llm_planning_components.py
index 3d4ed48..c756c3d 100644
--- a/tests/test_llm_planning_components.py
+++ b/tests/test_llm_planning_components.py
@@ -334,3 +334,22 @@ def test_llm_generation_service_repairs_invalid_plan():
     )
     assert outcome.parsed_plan is not None
     assert len(outcome.repair_history) == 1
+
+
+def test_deterministic_amplifier_plan_preserves_dc_bias_and_ac_excitation():
+    from spec2testbench.infrastructure.testbench.testbench_generator import TestBenchGenerator
+
+    specification = load_amplifier_spec()
+    testbench = TestBenchGenerator(use_llm=False).generate(specification, netlist_path=P01_NETLIST)
+    plan = testbench.metadata["llm_guided_plan"]
+    actions = [
+        action
+        for action in plan["source_actions"]
+        if action["new_source"].get("node_positive") == "Vin"
+    ]
+
+    assert len(actions) == 1
+    source = actions[0]["new_source"]
+    assert source["type"] == "ac"
+    assert source["dc_value"] == pytest.approx(1.0)
+    assert source["ac_magnitude"] == pytest.approx(1.0)
