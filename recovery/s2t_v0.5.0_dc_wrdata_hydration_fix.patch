-                "vout_dc": value,
-                "operating_point": value,
-                "vout": value,
+            # Native DC WRDATA uses ``wr_singlescale`` and writes:
+            #   column 0 -> swept source value
+            #   column 1 -> V(output)
+            #   column 2 -> I(Vdd), when available
+            # Preserve the full sweep. Semantic ACP metrics such as inverter
+            # endpoint voltages, comparator monotonicity and current-mirror
+            # stability require waveforms rather than a single terminal value.
+            sweep = data[:, 0].astype(float)
+            vout = data[:, 1].astype(float)
+            dc = {
+                "sweep": sweep.tolist(),
+                "source_values": sweep.tolist(),
+                "vout": vout.tolist(),
+                "vout_values": vout.tolist(),
+                "vout_waveform": vout.tolist(),
+                "output": vout.tolist(),
+                "voltage": {
+                    "vout": vout.tolist(),
+                },
+                "vout_dc": float(vout[-1]),
+                "operating_point": float(vout[-1]),
             }
+            if data.shape[1] >= 3:
+                current = data[:, 2].astype(float)
+                dc["current_waveforms"] = {"Vdd": current.tolist()}
+                results.setdefault("currents", {})
+                results["currents"].setdefault("vdd", float(current[-1]))
+            results["dc"] = dc
     
