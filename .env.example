# LLM Provider (openai, deepseek, gemini, anthropic)
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set explicitly after running DeepSeek model discovery.
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=3

# OpenAI API
OPENAI_API_KEY=

# Google Gemini API
GOOGLE_API_KEY=

# Use LLM (true/false)
USE_LLM=true
