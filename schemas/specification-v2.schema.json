    "case_id",
    "name",
    "circuit_type",
    "technology",
    "description",
    "provenance",
    "ports",
    "operating_conditions",
    "stimuli",
    "analyses",
    "functional_requirements",
    "performance_targets",
    "input_conditions",
    "measurement",
    "verification",
    "test_categories"
