        "purpose": {
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "purpose"
      ],
      "title": "StimulusSpec",
      "type": "object"
    },
    "UpstreamChecker": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "criterion_summary": {
          "items": {
            "type": "string"
          },
          "title": "Criterion Summary",
          "type": "array"
        },
        "upstream_mutates_dut": {
          "default": false,
          "title": "Upstream Mutates Dut",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "path"
      ],
      "title": "UpstreamChecker",
      "type": "object"
    },
    "VerificationPolicy": {
      "additionalProperties": false,
      "properties": {
        "auto_select": {
          "default": true,
          "title": "Auto Select",
          "type": "boolean"
        },
        "include_tests": {
          "items": {
            "type": "string"
          },
          "title": "Include Tests",
          "type": "array"
        },
        "exclude_tests": {
          "items": {
            "type": "string"
          },
          "title": "Exclude Tests",
          "type": "array"
        },
        "required_policy": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Required Policy",
          "type": "string"
        },
        "immutable_dut": {
          "default": true,
          "title": "Immutable Dut",
          "type": "boolean"
        },
        "not_evaluated_on_missing_mandatory_metric": {
          "default": true,
          "title": "Not Evaluated On Missing Mandatory Metric",
          "type": "boolean"
        },
        "require_full_contract_for_compliance": {
          "default": true,
          "title": "Require Full Contract For Compliance",
          "type": "boolean"
        }
      },
      "title": "VerificationPolicy",
      "type": "object"
    }
