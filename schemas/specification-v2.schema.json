  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "circuit_type": {
      "title": "Circuit Type",
      "type": "string"
    },
    "technology": {
      "title": "Technology",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "ports": {
      "$ref": "#/$defs/Ports"
    },
    "operating_conditions": {
      "$ref": "#/$defs/OperatingConditions"
    },
    "stimuli": {
      "items": {
        "$ref": "#/$defs/StimulusSpec"
      },
      "title": "Stimuli",
      "type": "array"
    },
    "analyses": {
      "items": {
        "$ref": "#/$defs/AnalysisSpec"
      },
      "title": "Analyses",
      "type": "array"
    },
    "functional_requirements": {
      "items": {
        "$ref": "#/$defs/FunctionalRequirement"
      },
      "title": "Functional Requirements",
      "type": "array"
    },
    "performance_targets": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricTarget"
      },
      "title": "Performance Targets",
      "type": "object"
    },
    "input_conditions": {
      "additionalProperties": true,
      "title": "Input Conditions",
      "type": "object"
    },
    "measurement": {
      "$ref": "#/$defs/MeasurementPolicy"
    },
    "verification": {
      "$ref": "#/$defs/VerificationPolicy"
    },
    "test_requirements": {
      "additionalProperties": true,
      "title": "Test Requirements",
      "type": "object"
    },
    "test_categories": {
      "items": {
        "type": "string"
      },
      "title": "Test Categories",
      "type": "array"
    },
    "pvt_config": {
      "additionalProperties": true,
      "title": "Pvt Config",
      "type": "object"
    }
