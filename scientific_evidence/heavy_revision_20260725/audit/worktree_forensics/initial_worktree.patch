-def _parse_pdfinfo_output(output: str) -> dict[str, str]:
-    info: dict[str, str] = {}
-    for line in output.splitlines():
-        if ":" not in line:
-            continue
-        key, value = line.split(":", 1)
-        normalized = key.strip().lower().replace(" ", "_")
-        info[normalized] = value.strip()
-    return info
