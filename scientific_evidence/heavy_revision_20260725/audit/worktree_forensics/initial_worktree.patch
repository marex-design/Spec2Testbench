-        "observed_behavior": observed_behavior,
-        "artifact_dir": rel(artifact_dir),
-        "stdout_path": rel(stdout_path),
-        "stderr_path": rel(stderr_path),
-        "generated_files": "|".join(rel(path) for path in (extra_paths or []) if path.exists()),
