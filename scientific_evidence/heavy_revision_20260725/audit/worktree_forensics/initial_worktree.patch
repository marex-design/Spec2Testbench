+            logger.info(f"Ngspice executable found at {self.ngspice_path}")
+            return True
+        logger.warning(f"Ngspice not found at {self.ngspice_path}")
+        logger.warning("Install ngspice or set NGSPICE_PATH in .env")
+        return False
